# Optional for public repositories, but strongly recommended for higher rate limits.
# Optional application metadata store; existing retrieval workflows do not require it.
DATABASE_URL=
# Only for disposable PostgreSQL integration databases, not application data.
TEST_DATABASE_URL=
# Local Compose only; choose passwords locally and URL-encode them in database URLs.
POSTGRES_PASSWORD=
POSTGRES_TEST_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=55432
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_CACHE_DIR=.cache/github
GITHUB_CACHE_TTL_SECONDS=3600
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=4
GITHUB_MAX_RETRY_WAIT_SECONDS=300
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=0
GITHUB_DOC_MAX_BYTES=1000000
INDEX_DIR=.cache/index
QDRANT_PATH=.cache/qdrant
QDRANT_COLLECTION=github_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_MAX_WORDS=220
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATES_PER_BACKEND=25
RRF_K=60
RERANK_CANDIDATE_POOL=40
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
LOG_LEVEL=INFO
# Required only for `github-intel ask`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_URL=https://api.openai.com/v1
GENERATION_TOP_K=8
GENERATION_MAX_CONTEXT_CHARS=30000
GENERATION_MAX_OUTPUT_TOKENS=1200
GENERATION_CITATION_REPAIR_ATTEMPTS=1
INVESTIGATION_MAX_STEPS=6
INVESTIGATION_MAX_MCP_CALLS=4
INVESTIGATION_MAX_SOURCES=12
MCP_SEARCH_LIMIT=5

# Phase 4 trusted-local API / durable worker. Both processes must share this root.
APPLICATION_ROOT=.cache/application-index
# Records embedding identity; configure a genuinely pinned checkpoint in EMBEDDING_MODEL.
APPLICATION_EMBEDDING_VERSION=
# API and worker processes require server mode. Embedded remains single-process only.
APPLICATION_QDRANT_MODE=server
APPLICATION_QDRANT_URL=http://127.0.0.1:6333
APPLICATION_QDRANT_API_KEY=
APPLICATION_QDRANT_TIMEOUT_SECONDS=5
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300

# Phase 5: only enable the GitHub receipt endpoint with a random secret (>=32 bytes).
GITHUB_WEBHOOKS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_MAX_BODY_BYTES=1000000
